{
  "name": "obsidian-noctua",
  "version": "0.3.0",
  "description": "Turn notes into audio with text-to-speech (TTS) and listen in your personal podcast feed. Save episode transcripts to your vault.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "noctua",
    "text-to-speech",
    "tts",
    "audio",
    "podcast",
    "read-aloud",
    "listen",
    "transcript"
  ],
  "author": "Glyn Darkin",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkin100/noctua-plugins-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/darkin100/noctua-plugins-obsidian/issues"
  },
  "homepage": "https://github.com/darkin100/noctua-plugins-obsidian#readme"
}
